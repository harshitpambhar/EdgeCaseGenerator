## =========================================================
## NEON DATABASE CONFIG (Cloud PostgreSQL)
## =========================================================
## Get credentials from: https://console.neon.tech/
## Replace with your actual Neon connection strings and credentials

AUTH_DB_URL=jdbc:postgresql://your-neon-host/auth_db?sslmode=require&channel_binding=require
USER_DB_URL=jdbc:postgresql://your-neon-host/user_db?sslmode=require&channel_binding=require

DB_USERNAME=neondb_owner
DB_PASSWORD=your-neon-password

## =========================================================
## SPRING BOOT PORTS
## =========================================================

CONFIG_SERVER_PORT=8888
EUREKA_SERVER_PORT=8761
API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
USER_SERVICE_PORT=8082
REPO_ANALYSIS_SERVICE_PORT=8083

## =========================================================
## CONFIG SERVER
## =========================================================

CONFIG_SERVER_URL=http://localhost:8888
CONFIG_SERVER_SEARCH_LOCATIONS=file:///path/to/backend/config-repo

## =========================================================
## JPA / HIBERNATE
## =========================================================

JPA_DDL_AUTO=update
SQL_INIT_MODE=always

## =========================================================
## FLYWAY
## =========================================================

FLYWAY_ENABLED=false

## =========================================================
## EUREKA
## =========================================================

EUREKA_CLIENT_ENABLED=true
EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka/

## =========================================================
## ZIPKIN
## =========================================================

ZIPKIN_EXPORT_ENABLED=false

## =========================================================
## FRONTEND
## =========================================================

VITE_API_URL=http://localhost:8080/api
FRONTEND_CORS_ORIGINS=http://localhost:5173

## =========================================================
## SECURITY
## =========================================================

INTERNAL_API_KEY=dev-internal-api-key-change-me
JWT_SECRET=dev-jwt-secret-must-be-at-least-32-chars-long!!
JWT_EXPIRATION_MS=86400000

## =========================================================
## ACTIVE PROFILE
## =========================================================

SPRING_PROFILES_ACTIVE=dev
