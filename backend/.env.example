## Shared DB connection (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

## Per-service databases
AUTH_DB_NAME=auth_db
USER_DB_NAME=user_db

## Spring Boot service ports
CONFIG_SERVER_PORT=8888
EUREKA_SERVER_PORT=8761
API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
USER_SERVICE_PORT=8082

## Spring Cloud Config client URL
CONFIG_SERVER_URL=http://localhost:8888

## JPA/SQL init (dev-friendly defaults)
JPA_DDL_AUTO=update
SQL_INIT_MODE=always

## Flyway (user-service): leave false unless you use classpath:db/migration scripts
FLYWAY_ENABLED=false

## Optional: set false when Eureka is not running (avoids noisy discovery errors)
# EUREKA_CLIENT_ENABLED=false

## Optional: set true when Zipkin is running on localhost:9411
ZIPKIN_EXPORT_ENABLED=false

## Frontend API base (browser → API Gateway only)
VITE_API_URL=http://localhost:8080/api

## Service-to-service and JWT (Auth + User must share INTERNAL_API_KEY)
INTERNAL_API_KEY=change-me-to-a-long-random-secret
JWT_SECRET=change-me-to-at-least-32-characters-long-secret
JWT_EXPIRATION_MS=86400000

## Eureka (start eureka-server before gateway and services for lb:// routing)
# EUREKA_CLIENT_ENABLED=false
EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka/

## CORS is configured only on API Gateway (config-repo/api-gateway.yml). Do not add CORS on auth/user.
