# Environment variables — copy to .env and fill in values
# All variables have safe defaults; only override what you need.

# Workspace
TEMP_WORKSPACE_ROOT=/tmp/ecg_workspaces

# Scanner
IGNORED_DIRS=node_modules,venv,.venv,build,dist,.git,target,__pycache__,.pytest_cache
MAX_FILE_SIZE_BYTES=1048576

# Execution
TEST_EXECUTION_TIMEOUT=120

# Git
GIT_CLONE_DEPTH=1
GIT_TIMEOUT=120

# Logging
LOG_LEVEL=INFO

# Docker worker (repo analysis via job-service)
DOCKER_HOST=unix:///var/run/docker.sock
DOCKER_WORKER_IMAGE=ecg-worker:latest
DOCKER_WORKER_TIMEOUT=900
